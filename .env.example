# Optional: URL of an authorized server-side proxy for BOLD Systems.
# Required only when the BOLD provider blocks browser requests with Cloudflare/CORS.
# The proxy must forward the taxon, page and per_page query parameters and return JSON.
# VITE_BOLD_PROXY_URL=https://your-authorized-proxy.example/api/bold

# Optional: URL of an authorized server-side proxy for Dryad.
# Dryad currently responds without browser CORS headers from its public API.
# VITE_DRYAD_PROXY_URL=https://your-authorized-proxy.example/api/dryad
